# Copy this file to config/env/.env and adjust. Every value is optional;
# defaults live in utilities/constants.ts.

# Target environment
BASE_URL=https://www.demoblaze.com
API_URL=https://api.demoblaze.com

# Existing account to log in with. Leave empty to have each test worker
# sign up a fresh throw-away account through the API.
TEST_USERNAME=
TEST_PASSWORD=

# Execution
WORKERS=4
RETRIES=1
HEADLESS=true

# Performance budgets (milliseconds)
PERF_PAGE_LOAD_BUDGET_MS=5000
PERF_API_P95_BUDGET_MS=1500
PERF_API_CONCURRENCY=10
